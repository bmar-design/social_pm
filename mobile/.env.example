EXPO_PUBLIC_API_URL=https://your-app-domain.example
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_APP_SCHEME=socialplays
EXPO_PUBLIC_IOS_BUNDLE_ID=com.yourcompany.socialplays

# Native Pascal account setup; UI preview never makes Pascal writes.
EXPO_PUBLIC_PASCAL_ENABLED=false
# Public builder account only. Never put a private key in environment variables.
EXPO_PUBLIC_PASCAL_BUILDER_PUBLIC_KEY=
# Decimal rate: 0.010000 means 1% of price*(1-price)*size, NOT 1% of stake.
EXPO_PUBLIC_PASCAL_BUILDER_FEE_RATE=
